# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
DB_NAME=restrovibe
DB_USER=postgres
DB_PASSWORD=your-strong-db-password
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=generate-a-strong-random-secret-min-64-chars
JWT_REFRESH_SECRET=generate-another-strong-random-secret

# Email (use dev mode to print reset links to console)
EMAIL_MODE=dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Overstay mitigation
OVERSTAY_GRACE_MINUTES=10
OVERSTAY_FEE_PER_MINUTE=2
